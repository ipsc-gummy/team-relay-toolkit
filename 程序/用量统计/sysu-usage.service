[Unit]
Description=Private per-key usage collector
After=cliproxyapi.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sysu-usage/usage.py --collect
Restart=on-failure
RestartSec=5
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
RuntimeDirectory=sysu-usage-query
RuntimeDirectoryMode=0755
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sysu-usage
InaccessiblePaths=/var/lib/cliproxyapi/auth
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=128M
TasksMax=16
StandardOutput=journal
StandardError=journal

# Deliberately no [Install]: starting this does not add boot autostart.
